#!/bin/sh
set -eu
cd -- "$(dirname -- "$0")"
# Set MODE=debug to run the debug binary.
binary=../src/OpticalDataCenter
if [ "${MODE:-release}" = debug ]; then binary=${binary}_dbg; fi
if [ ! -x "$binary" ] && [ -x "${binary}.exe" ]; then binary=${binary}.exe; fi
if [ ! -x "$binary" ]; then
    echo "Missing $binary. Run 'make makefiles && make MODE=${MODE:-release}' first." >&2
    exit 1
fi
exec "$binary" -n ../src:. "$@"
